# Aurora Cloud Relay — copy to .env for local runs (cloud hosts: set these in their dashboards)
PORT=8080
# Strong secret the exe uses to authenticate (auto-generated if left empty)
AUTH_TOKEN=
# Optional: Telegram bot token from @BotFather (can also be set later from the exe)
TELEGRAM_BOT_TOKEN=
# Optional display name shown on the status page
RELAY_NAME=Aurora Cloud Relay
# Where the WhatsApp session + token file live (mount a persistent volume in production)
DATA_DIR=./data
