# Aurora Cloud Relay v2 — copy to .env for local runs (cloud hosts: set these in their dashboards)
PORT=8080
# Strong secret the exe uses to authenticate (auto-generated if left empty)
AUTH_TOKEN=
# Telegram USER account login (get these from my.telegram.org -> API development tools).
# Optional here — you can also enter them from the exe (Cloud tab -> Telegram -> save keys).
TG_API_ID=
TG_API_HASH=
# Optional display name shown on the status page
RELAY_NAME=Aurora Cloud Relay
# Where sessions + token live (mount a persistent volume in production)
DATA_DIR=./data
